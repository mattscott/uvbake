<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>UVBake.Cli</RootNamespace>
    <AssemblyName>uvbake</AssemblyName>
    <Description>Command-line front-end for the UVBake library.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable as a .NET global/local tool: `dotnet tool install ... uvbake`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>uvbake</ToolCommandName>
    <PackageId>UVBake.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UVBake.Core\UVBake.Core.csproj" />
    <ProjectReference Include="..\UVBake.IO\UVBake.IO.csproj" />
  </ItemGroup>

</Project>
