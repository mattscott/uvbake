<Project>

  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Coding standards: analyzers on, style enforced, warnings fatal. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Reproducibility (success criterion: deterministic output). -->
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Packaging metadata. -->
    <Version>1.0.0</Version>
    <Authors>Matthew Scott</Authors>
    <Product>UVBake</Product>
    <Copyright>Copyright (c) 2026 Matthew Scott</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mattscott/uvbake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/mattscott/uvbake</PackageProjectUrl>
    <PackageTags>uv;uv-atlas;uv-unwrap;texture;parameterization;mesh;baking;lightmap</PackageTags>

    <!-- Emit XML docs for the public API (IntelliSense); CS1591 off so obvious members need no doc. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Embed source-control metadata only on CI builds. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
